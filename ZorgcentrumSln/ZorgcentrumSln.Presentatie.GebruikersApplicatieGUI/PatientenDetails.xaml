<Window x:Class="ZorgcentrumSln.Presentatie.GebruikersApplicatieGUI.PatientenDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZorgcentrumSln.Presentatie.GebruikersApplicatieGUI"
        mc:Ignorable="d"
        Title="PatientenDetails" Height="450" Width="520">
    <DockPanel>
        <StackPanel Name="ButtonStackPanel" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
            <Button Name="OpslaanButton" Content="Opslaan" Width="75" Margin="0,0,0,5" Click="OpslaanButton_Click"/>
            <Button Name="AnnulerenButton" Content="Annuleren" Width="75" Click="AnnulerenButton_Click"/>
        </StackPanel>

        <StackPanel Name="PatientStackPanel">
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="0,5"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style TargetType="Label">
                    <Setter Property="Width" Value="175"/>
                </Style>
                <Style TargetType="GroupBox">
                    <Setter Property="MinWidth" Value="200"/>
                </Style>
            </StackPanel.Resources>

            <Label Content="Patient Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Name="PatientSelectorStackPanel">
                <Label Content="Patient"/>
                <ComboBox Name="PatientSelectorComboBox" MinWidth="200" SelectionChanged="PatientSelectorComboBox_SelectionChanged" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" TextSearch.TextPath="Naam">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock Text="{Binding Naam}"/>
                                <TextBlock Text="{Binding Voornaam}"/>
                            </TextBlock>        
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Rijksregisternummer"/>
                <TextBox Name="RijksregisternummerTextBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Naam"/>
                <TextBox Name="NaamTextBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Voornaam"/>
                <TextBox Name="VoornaamTextBox"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Content="Afdelingen"/>
                <GroupBox Header="Afdelingen" Name="AfdelingenGroupBox">
                    <StackPanel Name="AfdelingenGroupBoxStackPanel">
                        
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
