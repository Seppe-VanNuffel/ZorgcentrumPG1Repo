<Window x:Class="ZorgcentrumSln.Presentatie.GebruikersApplicatieGUI.GebruikersModus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZorgcentrumSln.Presentatie.GebruikersApplicatieGUI"
        mc:Ignorable="d"
        Title="GebruikersModus" Height="220" Width="302">
    <Grid VerticalAlignment="Center">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Width" Value="100"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.ColumnSpan="2" HorizontalAlignment="Center">Welkom</Label>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,5">
            <TextBlock Text="Zorgcentrum is een applicatie voor" FontSize="14" Margin="0" HorizontalAlignment="Center"/>
            <TextBlock Text="het beheren van afspraken," FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="patient en artsen" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="kies modus:" FontSize="14" HorizontalAlignment="Center" Margin="0, 10, 0, 0"/>
        </StackPanel>
        <Button Name="ReadOnlyButton" Content="Read-only" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Click="ReadOnlyButton_Click"/>
        <Button Name="AdminButton" Content="Admin" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Click="AdminButton_Click"/>
    </Grid>
</Window>
